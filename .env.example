# Example environment variables for report-app
# Copy to .env and fill values (DO NOT commit real secrets)

GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_here
PORT=5000

GOOGLE_CLIENT_ID=

# SMTP Configuration
SMTP_HOST=mail.absoluteveritas.com
SMTP_PORT=465
SMTP_USER=cs@absoluteveritas.com
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=true
SMTP_FROM=cs@absoluteveritas.com
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb://<USER>:<PASSWORD>@<HOSTS>/<DB>?ssl=true&replicaSet=<REPLICA>&authSource=admin&appName=Cluster0

# Wasabi Configuration
WASABI_ACCESS_KEY=your_wasabi_access_key
WASABI_SECRET_KEY=your_wasabi_secret_key
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_REGION=ap-southeast-1
WASABI_BUCKET=absolute-veritas-dev
WASABI_TEST_PREFIX=test/
WASABI_SIGNED_URL_EXPIRY=600

# Optional debug
EMAIL_DEBUG_BCC=
